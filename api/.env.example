APP_NAME="O Chords API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev uses SQLite (database/database.sqlite). Staging/production: MySQL 8.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ochords
# DB_USERNAME=ochords
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- O Chords ---
# HMAC key for email lookups (emails are stored encrypted). Generate with: php -r "echo bin2hex(random_bytes(32));"
# Keep it in the secrets manager; changing it makes every existing account unfindable.
OCHORDS_LOOKUP_KEY=
# Days before a "delete my account" request is carried out.
OCHORDS_DELETION_GRACE_DAYS=30
# Password for the synthetic demo accounts created by DemoSeeder (local/staging only).
DEMO_PASSWORD=
# Retention: resolved reports and feedback are purged after this many days (open reports never are).
OCHORDS_REPORT_RETENTION_DAYS=180
OCHORDS_FEEDBACK_RETENTION_DAYS=365

# Sign in with Apple: the app's bundle ID, which Apple puts in the identity token's audience.
OCHORDS_APPLE_BUNDLE_ID=com.onezcodes.ochords
# Sign in with Google: the iOS OAuth client ID (Google Cloud console → Credentials). Empty = Google sign-in off (503).
OCHORDS_GOOGLE_CLIENT_ID=
# O Chords Pro: App Store product IDs that grant Pro, comma-separated.
OCHORDS_PRO_PRODUCTS=com.onezcodes.ochords.pro.monthly,com.onezcodes.ochords.pro.yearly
# Accept Sandbox/Xcode StoreKit transactions. Defaults to on outside production; never set it in production.
# OCHORDS_ALLOW_SANDBOX_RECEIPTS=true

# Server-side sheet reading (reads Myanmar lyrics). "google" or "none".
OCHORDS_SCAN_DRIVER=none
OCHORDS_SCAN_DAILY_LIMIT=30
# Google calls per month, all players together (Vision's free tier is 1,000). 0 = no limit.
OCHORDS_SCAN_MONTHLY_LIMIT=900
# Google Cloud Vision API key — restrict it to the Cloud Vision API (and your server's IPs) in the Google console.
GOOGLE_VISION_API_KEY=

# Filament /admin (StaffSeeder defaults in non-production only)
OCHORDS_ADMIN_SESSION_MINUTES=60
# OCHORDS_ADMIN_ALLOWED_IPS=203.0.113.10,198.51.100.0/24
OCHORDS_ADMIN_SEED_HANDLE=ochordsadmin
OCHORDS_ADMIN_SEED_EMAIL=admin@ochords.local
OCHORDS_ADMIN_SEED_PASSWORD=AdminChords2026!
# Require TOTP MFA after staff login (defaults on in production)
OCHORDS_ADMIN_REQUIRE_2FA=false
# Explore uploader for staff-imported sheets
OCHORDS_CATALOG_HANDLE=ochords
OCHORDS_CATALOG_EMAIL=catalog@ochords.local
OCHORDS_CATALOG_NAME="O Chords"

# Google Play billing (optional; empty = Android Pro sync returns 422)
# OCHORDS_PLAY_PACKAGE_NAME=com.onezcodes.ochords
# OCHORDS_PLAY_ACCESS_TOKEN=
# Path to Play Console service-account JSON (preferred over a static access token)
# OCHORDS_PLAY_SERVICE_ACCOUNT_JSON=/secure/play-sa.json

# Marketing store buttons (empty = “Coming soon”)
# OCHORDS_APP_STORE_URL=https://apps.apple.com/app/id…
# OCHORDS_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.onezcodes.ochords
# After clone, build before serving / /privacy /support:
#   cd ../web && npm ci && npm run build
